 {
  "id": "format.gprintf_mantissa_exponent",
  "argv": [
   "t.gp"
  ],
  "stdin": {
   "text": ""
  },
  "files": {
   "t.gp": {
    "text": "do for [v in \"0.000123 1 999 1e6 2.5e-9 -42\"] { print gprintf(\"%.2t x 10^%T\", v+0), gprintf(\"%s%c\", v+0), gprintf(\"%.1s %c\", v+0) }\n"
   }
  },
  "check_files": [],
  "expected": {
   "stdout": {
    "text": ""
   },
   "stderr": {
    "text": "1.23 x 10^-4 123.000000u 123.0 u\n1.00 x 10^0 1.000000 1.0 \n9.99 x 10^2 999.000000 999.0 \n\"t.gp\" line 1: warning: Trailing characters after numeric expression\n1.00 x 10^0 \"t.gp\" line 1: warning: Trailing characters after numeric expression\n1.000000 \"t.gp\" line 1: warning: Trailing characters after numeric expression\n1.0 \n2.50 x 10^-9 2.500000n 2.5 n\n-4.20 x 10^1 -42.000000 -42.0 \n"
   },
   "exit_code": 0,
   "files": {}
  }
 },
